{
  "name": "personal-site",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["services/*"],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "deploy": "bun run build && wrangler pages deploy ./out --project-name elliothu-personal-site --branch main",
    "cms:build": "bun run --cwd services/cms build",
    "cms:config": "bun run --cwd services/cms config",
    "cms:deploy": "bun run --cwd services/cms deploy",
    "cms:dev": "bun run --cwd services/cms dev",
    "cms:init": "bun run --cwd services/cms init",
    "cms:status": "bun run --cwd services/cms status"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "framer-motion": "^11.3.24",
    "lodash.throttle": "^4.1.1",
    "lucide-react": "^0.424.0",
    "next": "14.2.5",
    "react": "^18",
    "react-dom": "^18",
    "react-wrap-balancer": "^1.1.1",
    "tailwind-children": "^0.5.0",
    "tailwind-merge": "^2.4.0",
    "tailwind-scrollbar-hide": "^1.1.7"
  },
  "devDependencies": {
    "@types/lodash.throttle": "^4.1.9",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.12",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  }
}
